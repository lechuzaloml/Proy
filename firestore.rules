rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function conSesion() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function correo() {
      return request.auth.token.email.lower();
    }
    function esPlataforma() {
      return conSesion() && exists(/databases/$(database)/documents/plataformaAdmins/$(correo()));
    }
    function miembro(emp) {
      return get(/databases/$(database)/documents/empresas/$(emp)/miembros/$(correo()));
    }
    function esMiembro(emp) {
      return conSesion()
        && exists(/databases/$(database)/documents/empresas/$(emp)/miembros/$(correo()))
        && miembro(emp).data.estado == 'activo';
    }
    function esAdminEmpresa(emp) {
      return esMiembro(emp) && miembro(emp).data.rol == 'admin';
    }
    function tienePermiso(emp, permiso) {
      return esAdminEmpresa(emp)
        || (esMiembro(emp) && miembro(emp).data.permisos.get(permiso, false) == true);
    }
    function puedeVerLeads(emp) {
      return esPlataforma() || tienePermiso(emp, 'verLeads') || tienePermiso(emp, 'gestionarLeads');
    }
    function puedeGestionarLeads(emp) {
      return esPlataforma() || tienePermiso(emp, 'gestionarLeads');
    }
    function puedeEditarCuestionarios(emp) {
      return esPlataforma() || tienePermiso(emp, 'editarCuestionarios');
    }
    function empresaActiva(emp) {
      return exists(/databases/$(database)/documents/empresas/$(emp))
        && get(/databases/$(database)/documents/empresas/$(emp)).data.estado == 'activa';
    }
    function cuestionarioPublicado(emp, cid) {
      return empresaActiva(emp)
        && exists(/databases/$(database)/documents/empresas/$(emp)/cuestionarios/$(cid))
        && get(/databases/$(database)/documents/empresas/$(emp)/cuestionarios/$(cid)).data.estado == 'publicado';
    }
    function puedeLeerVersionPublicada(emp, cid, vid) {
      return empresaActiva(emp)
        && exists(/databases/$(database)/documents/empresas/$(emp)/cuestionarios/$(cid))
        && get(/databases/$(database)/documents/empresas/$(emp)/cuestionarios/$(cid)).data.publicacion.estado == 'publicado'
        && get(/databases/$(database)/documents/empresas/$(emp)/cuestionarios/$(cid)).data.publicacion.versionId == vid;
    }
    function copiaAutorizada(emp, cid) {
      return empresaActiva(emp)
        && puedeEditarCuestionarios(emp)
        && cid.matches('^personalizado-[A-Za-z0-9_-]{1,120}$')
        && exists(/databases/$(database)/documents/empresas/$(emp)/cuestionarios/$(cid))
        && get(/databases/$(database)/documents/empresas/$(emp)/cuestionarios/$(cid)).data.estado == 'borrador'
        && get(/databases/$(database)/documents/empresas/$(emp)/cuestionarios/$(cid)).data.id == cid
        && get(/databases/$(database)/documents/empresas/$(emp)/cuestionarios/$(cid)).data.configuracion.id == cid;
    }
    function ctaValida(cta) {
      return cta is map
        && cta.keys().hasAll(['texto','accion'])
        && cta.keys().hasOnly(['texto','accion'])
        && texto(cta.texto, 1, 300)
        && texto(cta.accion, 1, 500);
    }
    function resultadoCopiaValido(resultado, segmentado) {
      return resultado is map
        && (
          (!segmentado
            && resultado.keys().hasAll(['tipo','contenido'])
            && resultado.keys().hasOnly(['tipo','contenido','cta'])
            && resultado.tipo == 'fijo'
            && texto(resultado.contenido, 1, 5000)
            && (!('cta' in resultado) || ctaValida(resultado.cta)))
          ||
          (segmentado
            && resultado.keys().hasAll(['tipo','resultados'])
            && resultado.keys().hasOnly(['tipo','resultados'])
            && resultado.tipo == 'por_segmento'
            && resultado.resultados is list
            && resultado.resultados.size() == 1
            && resultado.resultados[0] is map
            && resultado.resultados[0].keys().hasAll(['segmento','contenido'])
            && resultado.resultados[0].keys().hasOnly(['segmento','contenido','cta'])
            && texto(resultado.resultados[0].segmento, 1, 80)
            && texto(resultado.resultados[0].contenido, 1, 5000)
            && (!('cta' in resultado.resultados[0]) || ctaValida(resultado.resultados[0].cta)))
        );
    }
    function envioCopiaValido(emp, did) {
      let diagnostico = getAfter(/databases/$(database)/documents/empresas/$(emp)/diagnosticos/$(did)).data;
      let lead = getAfter(/databases/$(database)/documents/empresas/$(emp)/leads/$(did)).data;
      let cuestionario = get(/databases/$(database)/documents/empresas/$(emp)/cuestionarios/$(diagnostico.cuestionarioId)).data;
      return copiaAutorizada(emp, diagnostico.cuestionarioId)
        && diagnostico.leadId == did
        && !('versionId' in diagnostico)
        && 'resultado' in diagnostico
        && resultadoCopiaValido(diagnostico.resultado, cuestionario.configuracion.usa_scoring)
        && (
          (cuestionario.configuracion.usa_scoring == true
            && diagnostico.keys().hasAll(['puntajeTotal','segmento'])
            && texto(diagnostico.segmento, 1, 80)
            && diagnostico.resultado.resultados[0].segmento == diagnostico.segmento
            && (!('ultimoSegmento' in lead) || lead.ultimoSegmento == diagnostico.segmento))
          ||
          (cuestionario.configuracion.usa_scoring == false
            && !diagnostico.keys().hasAny(['puntajeTotal','puntajeMaximo','porcentaje','segmento','puntajePorDimension'])
            && !lead.keys().hasAny(['ultimoPorcentaje','ultimoSegmento']))
        )
        && existsAfter(/databases/$(database)/documents/empresas/$(emp)/leads/$(did))
        && lead.origen == 'copia-clear-ia';
    }
    function versionActual(emp, cid) {
      return get(/databases/$(database)/documents/empresas/$(emp)/cuestionarios/$(cid)).data.versionActualId;
    }
    function texto(v, minimo, maximo) {
      return v is string && v.size() >= minimo && v.size() <= maximo;
    }
    function nuevo() {
      return request.resource.data;
    }

    match /plataformaAdmins/{id} {
      allow get: if conSesion() && correo() == id;
      allow list, write: if false;
    }

    match /empresas/{emp} {
      allow get: if true;
      allow list, write: if esPlataforma();

      match /miembros/{id} {
        allow get: if conSesion() && correo() == id;
        allow list: if esAdminEmpresa(emp) || esPlataforma();
        allow delete: if esAdminEmpresa(emp) || esPlataforma();
        allow create, update: if (esAdminEmpresa(emp) || esPlataforma())
          && nuevo().keys().hasOnly(['correo','rol','permisos','estado','creadoEn'])
          && id == id.lower()
          && nuevo().correo == id
          && nuevo().rol in ['admin','usuario']
          && nuevo().estado in ['activo','inactivo']
          && nuevo().permisos is map;
      }

      match /cuestionarios/{cid} {
        allow get: if (resource.data.estado == 'publicado' && empresaActiva(emp)) || puedeEditarCuestionarios(emp);
        allow list: if puedeEditarCuestionarios(emp);
        allow create: if puedeEditarCuestionarios(emp)
          && nuevo().keys().hasOnly(['id','nombre','estado','configuracion','creadoPor','creadoEn','actualizadoEn'])
          && nuevo().estado == 'borrador';
        allow update: if puedeEditarCuestionarios(emp)
          && nuevo().diff(resource.data).affectedKeys()
            .hasOnly(['nombre','estado','configuracion','actualizadoEn'])
          && nuevo().estado == 'borrador';
        allow delete: if puedeEditarCuestionarios(emp);

        match /versiones/{vid} {
          allow get: if puedeLeerVersionPublicada(emp, cid, vid)
            || puedeEditarCuestionarios(emp);
          allow list: if puedeEditarCuestionarios(emp);
          allow write: if false;
        }
      }

      match /leads/{lid} {
        allow create: if empresaActiva(emp)
          && nuevo().keys().hasAll(['nombre','correo','telefono','consentimiento','estado','ultimoDiagnosticoId','ultimaActividadEn','creadoEn'])
          && nuevo().keys().hasOnly(['nombre','correo','telefono','consentimiento','origen','estado','ultimaActividadEn','ultimoDiagnosticoId','ultimoPorcentaje','ultimoSegmento','ultimaCalificacion','creadoEn'])
          && texto(nuevo().nombre, 1, 120)
          && texto(nuevo().correo, 5, 200)
          && nuevo().correo == nuevo().correo.lower()
          && nuevo().correo.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
          && texto(nuevo().telefono, 5, 30)
          && nuevo().consentimiento is map
          && nuevo().consentimiento.keys().hasAll(['aceptado','version','fecha'])
          && nuevo().consentimiento.keys().hasOnly(['aceptado','version','fecha'])
          && nuevo().consentimiento.aceptado == true
          && texto(nuevo().consentimiento.version, 1, 40)
          && nuevo().consentimiento.fecha == request.time
          && nuevo().estado == 'nuevo'
          && nuevo().ultimoDiagnosticoId == lid
          && nuevo().ultimaActividadEn == request.time
          && nuevo().creadoEn == request.time
          && (!('origen' in nuevo()) || texto(nuevo().origen, 1, 100))
          && (!('ultimoPorcentaje' in nuevo()) || (nuevo().ultimoPorcentaje is number && nuevo().ultimoPorcentaje >= 0 && nuevo().ultimoPorcentaje <= 100))
          && (!('ultimoSegmento' in nuevo()) || texto(nuevo().ultimoSegmento, 1, 80))
          && (!('ultimaCalificacion' in nuevo()) || texto(nuevo().ultimaCalificacion, 1, 40))
          && existsAfter(/databases/$(database)/documents/empresas/$(emp)/diagnosticos/$(lid))
          && (!('origen' in nuevo()) || nuevo().origen != 'copia-clear-ia'
            || copiaAutorizada(emp, getAfter(/databases/$(database)/documents/empresas/$(emp)/diagnosticos/$(lid)).data.cuestionarioId));

        allow get, list: if puedeVerLeads(emp);

                allow update: if puedeGestionarLeads(emp)
          && nuevo().diff(resource.data).affectedKeys().hasOnly(['estado','asignadoA','contactadoEn','ultimaActividadEn'])
          && nuevo().estado in ['nuevo','contactado','interesado','convertido','descartado']
          && (!nuevo().diff(resource.data).affectedKeys().hasAny(['contactadoEn'])
              || (!('contactadoEn' in resource.data) && nuevo().contactadoEn == request.time))
          && (!nuevo().diff(resource.data).affectedKeys().hasAny(['ultimaActividadEn'])
              || nuevo().ultimaActividadEn == request.time);

        allow delete: if esAdminEmpresa(emp) || esPlataforma();

        match /seguimientos/{sid} {
          allow read: if puedeVerLeads(emp);
          allow create: if puedeGestionarLeads(emp)
            && nuevo().keys().hasAll(['tipo','notas','creadoPor','creadoEn'])
            && nuevo().keys().hasOnly(['tipo','notas','resultado','proximaAccionEn','creadoPor','creadoEn'])
            && nuevo().tipo in ['llamada','whatsapp','correo','nota']
            && texto(nuevo().notas, 1, 2000)
            && nuevo().creadoPor == correo()
            && nuevo().creadoEn == request.time
            && (!('resultado' in nuevo()) || texto(nuevo().resultado, 1, 500))
            && (!('proximaAccionEn' in nuevo()) || nuevo().proximaAccionEn is timestamp);
          allow update: if false;
          allow delete: if esAdminEmpresa(emp) || esPlataforma();
        }
      }

      match /diagnosticos/{did} {
        allow create: if empresaActiva(emp)
          && nuevo().keys().hasAll(['leadId','cuestionarioId','respuestas','completadoEn'])
          && nuevo().keys().hasOnly(['leadId','cuestionarioId','versionId','respuestas','resultado','puntajeTotal','puntajeMaximo','porcentaje','segmento','puntajePorDimension','calificacionComercial','templateRecomendadoId','planRecomendadoId','completadoEn'])
          && nuevo().leadId == did
          && texto(nuevo().cuestionarioId, 1, 100)
          && (
            (cuestionarioPublicado(emp, nuevo().cuestionarioId)
              && 'versionId' in nuevo()
              && texto(nuevo().versionId, 1, 40)
              && nuevo().versionId == versionActual(emp, nuevo().cuestionarioId))
            || envioCopiaValido(emp, did)
          )
          && nuevo().respuestas is map
          && nuevo().respuestas.size() <= 60
          && nuevo().completadoEn == request.time
          && (!('puntajeTotal' in nuevo()) || (nuevo().puntajeTotal is number && (nuevo().puntajeTotal >= 0 || envioCopiaValido(emp, did))))
          && (!('puntajeMaximo' in nuevo()) || (nuevo().puntajeMaximo is number && nuevo().puntajeMaximo > 0))
          && (!('porcentaje' in nuevo()) || (nuevo().porcentaje is number && nuevo().porcentaje >= 0 && nuevo().porcentaje <= 100))
          && (!('puntajeTotal' in nuevo() && 'puntajeMaximo' in nuevo()) || nuevo().puntajeTotal <= nuevo().puntajeMaximo)
          && (!('segmento' in nuevo()) || texto(nuevo().segmento, 1, 80))
          && (!('puntajePorDimension' in nuevo()) || (nuevo().puntajePorDimension is map && nuevo().puntajePorDimension.size() <= 20))
          && (!('calificacionComercial' in nuevo()) || nuevo().calificacionComercial is map)
          && (!('templateRecomendadoId' in nuevo()) || texto(nuevo().templateRecomendadoId, 1, 100))
          && (!('planRecomendadoId' in nuevo()) || texto(nuevo().planRecomendadoId, 1, 80))
          && existsAfter(/databases/$(database)/documents/empresas/$(emp)/leads/$(did));

        allow read: if puedeVerLeads(emp);
        allow update: if false;
        allow delete: if esAdminEmpresa(emp) || esPlataforma();
      }
    }

    match /{path=**}/miembros/{id} {
      allow read: if conSesion() && resource.data.correo == correo();
    }
  }
}