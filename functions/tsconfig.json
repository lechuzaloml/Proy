{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "rootDir": "..",
    "outDir": "lib",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [
    "src/**/*.ts",
    "../src/lib/construirDocumentosDiagnostico.ts",
    "../src/logic/calcularResultado.ts",
    "../src/logic/calcularPerfilSecciones.ts",
    "../src/types/**/*.ts",
    "../src/config/privacidad.ts",
    "../src/config/firebaseDatos.ts",
    "../src/validation/validarCuestionario.ts"
  ]
}
