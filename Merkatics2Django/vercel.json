{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "python manage.py collectstatic --noinput",
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/api/index.py"
    }
  ],
  "crons": [
    {
      "path": "/cron/limpiar-temporales/",
      "schedule": "0 5 * * *"
    }
  ]
}
